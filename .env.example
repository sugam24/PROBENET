# ProbeNet — Example Environment Configuration
# Copy this file to .env when local overrides are needed.
# Never put real credentials in this example file.

# RIPE Atlas streaming endpoint
PROBENET_ATLAS_STREAM_URL=wss://atlas-stream.ripe.net/stream/?client=probenet

# Collector settings
PROBENET_LOG_LEVEL=INFO
PROBENET_QUEUE_MAXSIZE=1000
PROBENET_RECONNECT_DELAY_SECONDS=5
